# Neon Postgres
DATABASE_URL=

# Neon Auth (Better Auth) — from Neon Console: Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=  # generate: openssl rand -base64 32

# GitHub OAuth App (configure in Neon Console: Project → Branch → Auth → OAuth Providers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (for private repo access)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Groq AI
GROQ_API_KEY=

# App
NEXT_PUBLIC_APP_URL=https://gitimposters.com
GITHUB_PAT=
